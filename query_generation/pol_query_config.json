{
  "name": "pol_mobilitydb",
  "schema": "pol",
  "srid": 26916,
  "entity": {
    "table": "trips",
    "key": "trip_id",
    "expression": "t.trip_id"
  },
  "tables": {
    "agents": {
      "name": "pol.agents",
      "alias": "a",
      "primary_key": "agent_id",
      "flags": ["standard"],
      "attributes": [
        {
          "name": "age",
          "type": "numeric",
          "dimension": "standard",
          "expression": "a.age",
          "domain": {"min": 18.083333333333332, "max": 60.083333333333336}
        },
        {
          "name": "educationLevel",
          "type": "nominal",
          "dimension": "standard",
          "expression": "a.\"educationLevel\"",
          "values": ["Bachelors", "Graduate", "HighSchoolOrCollege", "Low"]
        },
        {
          "name": "interest",
          "type": "nominal",
          "dimension": "standard",
          "expression": "a.interest",
          "values": ["A", "B", "C", "D", "E", "F", "G", "H", "I", "J"]
        },
        {
          "name": "joviality",
          "type": "numeric",
          "dimension": "standard",
          "expression": "a.joviality",
          "domain": {"min": 0.00035659368742091413, "max": 0.9986880684433143}
        },
        {
          "name": "family_size",
          "type": "integer",
          "dimension": "standard",
          "expression": "a.family_size",
          "domain": {"min": 1, "max": 3}
        }
      ]
    },
    "trips": {
      "name": "pol.trips",
      "alias": "t",
      "primary_key": "trip_id",
      "flags": ["standard", "temporal", "spatial"],
      "attributes": [
        {
          "name": "num_of_segments",
          "type": "integer",
          "dimension": "standard",
          "expression": "t.num_of_segments",
          "domain": {"min": 1, "max": 63}
        },
        {
          "name": "trip_time",
          "type": "temporal_interval",
          "dimension": "temporal",
          "start_expression": "t.start_time",
          "end_expression": "t.end_time",
          "temporal_geometry_expression": "t.trip_tgeom",
          "domain": {"min": "2019-07-01 06:25:00", "max": "2020-06-30 00:03:01.055"}
        },
        {
          "name": "trip_geom",
          "type": "geometry",
          "dimension": "spatial",
          "expression": "t.trip_geom",
          "srid": 26916,
          "domain": {
            "min_x": 739887.2356512973,
            "min_y": 3733936.9598094677,
            "max_x": 744069.4945482849,
            "max_y": 3738855.946876442
          }
        }
      ]
    },
    "segments": {
      "name": "pol.segments",
      "alias": "s",
      "primary_key": "trip_id, segment_idx",
      "flags": ["standard", "temporal", "spatial"],
      "attributes": [
        {
          "name": "segment_idx",
          "type": "integer",
          "dimension": "standard",
          "expression": "s.segment_idx",
          "domain": {"min": 0, "max": 62}
        },
        {
          "name": "segment_time",
          "type": "temporal_interval",
          "dimension": "temporal",
          "start_expression": "s.t_s",
          "end_expression": "s.t_e",
          "temporal_geometry_expression": "s.segment_tgeom",
          "domain": {"min": "2019-07-01 06:25:00", "max": "2020-06-30 00:03:01.055"}
        },
        {
          "name": "segment_geom",
          "type": "geometry",
          "dimension": "spatial",
          "expression": "s.segment_geom",
          "srid": 26916,
          "domain": {
            "min_x": 739887.2356512973,
            "min_y": 3733936.9598094677,
            "max_x": 744069.4945482849,
            "max_y": 3738855.946876442
          }
        }
      ]
    }
  },
  "joins": [
    {
      "left": "agents",
      "right": "trips",
      "condition": "a.agent_id = t.agent_id"
    },
    {
      "left": "trips",
      "right": "segments",
      "condition": "t.trip_id = s.trip_id"
    }
  ]
}
